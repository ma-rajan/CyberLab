# Server
PORT=3001
NODE_ENV=development

# SQLite
DATABASE_URL="file:./dev.db"

# Browser origin permitted to call the local API
CLIENT_ORIGIN=http://localhost:5173

# Session lifetime in days. Keep this value modest on shared computers.
SESSION_TTL_DAYS=7

# File Upload lab storage limits: 32 KB maximum per request, plus these aggregate quotas.
LAB_UPLOAD_MAX_FILES_PER_LEARNER=10
LAB_UPLOAD_MAX_BYTES_PER_LEARNER=262144
LAB_UPLOAD_MAX_BYTES_GLOBAL=16777216
LAB_UPLOAD_TTL_HOURS=24
